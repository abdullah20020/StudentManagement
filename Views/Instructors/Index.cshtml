@model List<Instructor>
@{
    ViewData["Title"] = T("Instructors");
    var term = ViewBag.Term as AcademicTerm;
}

<div class="page-head">
    <div>
        <h2>@T("Instructors")</h2>
        <div class="sub">@T("{0} member(s) of teaching staff", Model.Count)</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> @T("New instructor")</a>
</div>

<form method="get" class="filter-bar row g-2">
    <div class="col-md-5">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="@T("Search name or email")" />
        </div>
    </div>
    <div class="col-md-5">
        <select name="departmentId" class="form-select">
            <option value="">@T("All departments")</option>
            @foreach (var d in ViewBag.Departments)
            {
                <option value="@d.Id" selected="@(ViewBag.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-secondary w-100">@T("Filter")</button></div>
</form>

<div class="table-wrap">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>@T("Name")</th><th>@T("Department")</th><th>@T("Email")</th><th>@T("Office")</th><th>@T("Teaching in {0}", term?.Name ?? "")</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr class="@(i.IsActive ? "" : "text-muted")">
                    <td><a asp-action="Details" asp-route-id="@i.Id" class="fw-semibold">@i.FullName</a> @if (!i.IsActive) { <span class="badge bg-secondary">@T("Inactive")</span> }</td>
                    <td class="small">@i.Department?.Name<div class="text-muted">@i.Department?.Faculty?.Code</div></td>
                    <td class="small" dir="ltr">@i.Email</td>
                    <td class="small">@(i.Office ?? "—")</td>
                    <td class="small">
                        @foreach (var s in i.Sections.OrderBy(s => s.Subject?.Code))
                        {
                            <span class="badge bg-light text-dark border">@s.Subject?.Code-@s.Number</span>
                        }
                    </td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary" title="@T("Edit")"><i class="bi bi-pencil"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">@T("No instructors found.")</p>
}
