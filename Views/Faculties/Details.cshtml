@model Faculty
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-head">
    <div>
        <h2>@Model.Name</h2>
        <div class="sub"><code>@Model.Code</code> · @T("Dean"): @(Model.Dean ?? "—")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> @T("Edit")</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="@T("Delete this faculty?")">
            <button class="btn btn-outline-danger"><i class="bi bi-trash"></i> @T("Delete")</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">@T("Back")</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p>@Model.Description</p>
}

<div class="card">
    <div class="card-header"><i class="bi bi-diagram-3"></i> @T("Departments")</div>
    @if (Model.Departments.Any())
    {
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>@T("Code")</th><th>@T("Department")</th><th>@T("Head of department")</th><th>@T("Programs")</th><th class="text-end">@T("Instructors")</th><th class="text-end">@T("Students")</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Departments.OrderBy(d => d.Name))
                {
                    <tr>
                        <td><code>@d.Code</code></td>
                        <td class="fw-semibold">@d.Name</td>
                        <td class="small">@(d.HeadOfDepartment ?? "—")</td>
                        <td class="small">
                            @foreach (var c in d.Courses)
                            {
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" class="me-2">@c.Code</a>
                            }
                        </td>
                        <td class="text-end"><a asp-controller="Instructors" asp-action="Index" asp-route-departmentId="@d.Id">@d.Instructors.Count</a></td>
                        <td class="text-end">@d.Courses.Sum(c => c.Students.Count)</td>
                        <td class="text-end">
                            <form asp-action="DeleteDepartment" asp-route-id="@d.Id" method="post" data-confirm="@T("Delete this department?")">
                                <button class="btn btn-sm btn-outline-danger" title="@T("Delete")"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="card-body text-muted">@T("No departments yet.")</div>
    }
    <div class="card-footer">
        <form asp-action="AddDepartment" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">@T("Code")</label>
                <input name="Code" class="form-control form-control-sm" maxlength="20" dir="ltr" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">@T("Name")</label>
                <input name="Name" class="form-control form-control-sm" required maxlength="200" />
            </div>
            <div class="col-md-4">
                <label class="form-label small mb-1">@T("Head of department")</label>
                <input name="HeadOfDepartment" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-success w-100">+ @T("Add department")</button>
            </div>
        </form>
    </div>
</div>
