@model List<Room>
@{
    ViewData["Title"] = T("Rooms");
    var usage = (Dictionary<int, int>)ViewBag.Usage;
    var term = ViewBag.Term as AcademicTerm;
}

<div class="page-head">
    <div>
        <h2>@T("Rooms")</h2>
        <div class="sub">@T("Lecture halls, classrooms and labs.")</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> @T("New room")</a>
</div>

<div class="table-wrap">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>@T("Code")</th><th>@T("Building")</th><th>@T("Type")</th><th class="text-end">@T("Capacity")</th><th class="text-end">@T("Weekly classes in {0}", term?.Name ?? "")</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@r.Id"><strong>@r.Code</strong></a></td>
                    <td>@r.Building</td>
                    <td>@T(r.Type)</td>
                    <td class="text-end">@r.Capacity</td>
                    <td class="text-end">@usage.GetValueOrDefault(r.Id)</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-week"></i> @T("Timetable")</a>
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="@T("Edit")"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" data-confirm="@T("Delete this room?")">
                            <button class="btn btn-sm btn-outline-danger" title="@T("Delete")"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
