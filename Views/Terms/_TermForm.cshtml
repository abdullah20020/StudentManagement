@model AcademicTerm

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Season" class="form-label"></label>
        <select asp-for="Season" class="form-select">
            @foreach (var s in AcademicTerm.Seasons) { <option value="@s">@T(s)</option> }
        </select>
        <span asp-validation-for="Season" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" type="number" class="form-control" />
        <span asp-validation-for="Year" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
    <div class="col-12 d-flex gap-4">
        <div class="form-check">
            <input asp-for="IsCurrent" class="form-check-input" />
            <label asp-for="IsCurrent" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="RegistrationOpen" class="form-check-input" />
            <label asp-for="RegistrationOpen" class="form-check-label"></label>
        </div>
    </div>
</div>
