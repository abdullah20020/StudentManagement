@{
    ViewData["Title"] = T("Access denied");
}

<div class="text-center py-5">
    <div class="display-4 text-danger mb-3"><i class="bi bi-shield-lock"></i></div>
    <h2>@T("Access denied")</h2>
    <p class="text-muted">@T("Your account doesn't have permission to open this page.")</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@T("Go to my home page")</a>
</div>
