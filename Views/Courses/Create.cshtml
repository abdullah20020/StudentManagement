@model Course
@{
    ViewData["Title"] = T("New program");
}

<div class="page-head"><h2>@T("New program")</h2></div>

<form asp-action="Create" method="post" class="form-card">
    <partial name="_CourseForm" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> @T("Save")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T("Cancel")</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
