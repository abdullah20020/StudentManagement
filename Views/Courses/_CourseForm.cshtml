@model Course

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control text-uppercase" dir="ltr" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DepartmentId" class="form-label">@T("Department")</label>
        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
            <option value="">@T("-- Select department --")</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Credits" class="form-label">@T("Total credit hours")</label>
        <input asp-for="Credits" class="form-control" min="0" />
        <span asp-validation-for="Credits" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DurationYears" class="form-label">@T("Duration (years)")</label>
        <input asp-for="DurationYears" class="form-control" min="1" max="10" />
        <span asp-validation-for="DurationYears" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@T("Active")</label>
        </div>
    </div>
</div>
