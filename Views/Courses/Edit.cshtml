@model Course
@{
    ViewData["Title"] = T("Edit program");
}

<div class="page-head"><h2>@T("Edit program")</h2></div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <input type="hidden" asp-for="Id" />

    <partial name="_CourseForm" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> @T("Save changes")</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@T("Cancel")</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
