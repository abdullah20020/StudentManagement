@model IEnumerable<Course>
@{
    ViewData["Title"] = T("Programs");
}

<div class="page-head">
    <div>
        <h2>@T("Programs")</h2>
        <div class="sub">@T("Degree programs and their study plans.")</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> @T("New program")</a>
</div>

<form method="get" class="filter-bar row g-2">
    <div class="col-md-5">
        <select name="departmentId" class="form-select">
            <option value="">@T("All departments")</option>
            @foreach (var d in ViewBag.Departments)
            {
                <option value="@d.Id" selected="@(ViewBag.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-secondary w-100">@T("Filter")</button></div>
</form>

<div class="table-wrap">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@T("Code")</th>
                <th>@T("Name")</th>
                <th>@T("Department")</th>
                <th class="text-end">@T("Credits")</th>
                <th class="text-end">@T("Years")</th>
                <th class="text-end">@T("Subjects")</th>
                <th class="text-end">@T("Students")</th>
                <th>@T("Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Code</code></td>
                    <td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold">@c.Name</a></td>
                    <td class="small">@c.Department?.Name</td>
                    <td class="text-end">@c.Credits</td>
                    <td class="text-end">@c.DurationYears</td>
                    <td class="text-end">@c.Subjects.Count</td>
                    <td class="text-end">@c.Students.Count</td>
                    <td>
                        @if (c.IsActive) { <span class="badge bg-success">@T("Active")</span> }
                        else { <span class="badge bg-secondary">@T("Inactive")</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="@T("View")"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary" title="@T("Edit")"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted mt-3">@T("No programs found.")</p>
}
