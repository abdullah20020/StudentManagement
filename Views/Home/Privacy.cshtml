@{
    ViewData["Title"] = T("Privacy policy");
}
<div class="form-card">
    <h2 class="mb-3">@ViewData["Title"]</h2>
    <p>@T("The university keeps student and staff records only to run its academic services. Records are visible to the student concerned, their instructors (for their own sections) and authorised staff.")</p>
    <p class="mb-0">@T("For questions about your data, contact the registrar's office.")</p>
</div>
