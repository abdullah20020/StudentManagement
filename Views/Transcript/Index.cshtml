@model List<TermRecord>
@{
    var student = (Student)ViewBag.Student;
    ViewData["Title"] = T("Transcript") + " – " + student.FullName;
    var last = Model.LastOrDefault();
    // Subjects retaken later don't count in the CGPA; mark the earlier attempts.
    var latestAttempt = Model.SelectMany(t => t.Grades).GroupBy(g => g.SubjectId)
        .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Term!.StartDate).Last().Id);
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h2 class="mb-0">@T("Academic transcript")</h2>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> @T("Print")</button>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-secondary">@T("Back to student")</a>
        }
    </div>
</div>

<div class="card"><div class="card-body p-4">
    <div class="d-flex flex-column align-items-center text-center mb-4 pb-3 border-bottom">
        <partial name="_Crest" />
        <h4 class="mb-0 mt-2">@T(UniversityName)</h4>
        <div class="text-muted">@student.Course?.Department?.Faculty?.Name</div>
        <div class="fw-semibold mt-1 text-uppercase" style="letter-spacing:.08em">@T("Official academic transcript")</div>
    </div>

    <div class="row mb-3 small">
        <div class="col-sm-6">
            <div><strong>@T("Name"):</strong> @student.FullName</div>
            <div><strong>@T("Student ID"):</strong> @student.AdmissionNumber</div>
            <div><strong>@T("Program"):</strong> @student.Course?.Name</div>
        </div>
        <div class="col-sm-6 text-sm-end">
            <div><strong>@T("Department"):</strong> @student.Course?.Department?.Name</div>
            <div><strong>@T("Admitted"):</strong> @Date(student.EnrollmentDate)</div>
            <div><strong>@T("Issued"):</strong> @Date(DateTime.Today)</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">@T("No grades recorded yet.")</p>
    }

    @foreach (var t in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <strong>@t.Term.Name</strong>
                <span class="fw-normal">@T("Term GPA") <strong>@(t.TermGpa?.ToString("0.00") ?? "—")</strong> · @T("CGPA") <strong>@(t.Cgpa?.ToString("0.00") ?? "—")</strong></span>
            </div>
            <table class="table table-sm">
                <thead><tr><th>@T("Code")</th><th>@T("Subject")</th><th class="text-end">@T("Credits")</th><th class="text-end">@T("Score")</th><th class="text-center">@T("Grade")</th><th class="text-end">@T("Points")</th></tr></thead>
                <tbody>
                    @foreach (var g in t.Grades)
                    {
                        var superseded = latestAttempt[g.SubjectId] != g.Id;
                        <tr class="@(superseded ? "text-muted" : "")">
                            <td><code>@g.Subject?.Code</code></td>
                            <td>@g.Subject?.Name @if (superseded) { <span class="small">(@T("retaken later — not in CGPA"))</span> }</td>
                            <td class="text-end">@g.Subject?.Credits</td>
                            <td class="text-end">@g.Score.ToString("0.#")</td>
                            <td class="text-center"><span class="badge @Grade.Badge(g.LetterGrade)">@g.LetterGrade</span></td>
                            <td class="text-end">@g.Points.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="small text-muted">
                    <tr><td colspan="6">@T("Term credits {0} · earned to date {1}", t.TermCredits, t.EarnedCredits)</td></tr>
                </tfoot>
            </table>
        </div>
    }

    @if (last != null)
    {
        <div class="card border-success">
            <div class="card-body d-flex flex-wrap gap-4 justify-content-between">
                <div><div class="small text-muted">@T("Cumulative GPA")</div><div class="fs-4 fw-bold">@last.Cgpa?.ToString("0.00")</div></div>
                <div><div class="small text-muted">@T("Credits earned")</div><div class="fs-4 fw-bold">@last.EarnedCredits / @student.Course?.Credits</div></div>
                <div><div class="small text-muted">@T("Level")</div><div class="fs-4 fw-bold">@Academic.Level(last.EarnedCredits)</div></div>
                <div><div class="small text-muted">@T("Standing")</div><div class="fs-5"><span class="badge @Academic.StandingBadge(last.Cgpa)">@T(Academic.Standing(last.Cgpa))</span></div></div>
            </div>
        </div>
    }

    <p class="small text-muted mt-3 mb-0">
        @T("Grading scale"): <span dir="ltr">@string.Join(" · ", Grade.Scale.Select(s => $"{s.Letter} ≥ {s.Min} ({s.Points:0.0})"))</span>.
        @T("When a subject is retaken, only the latest attempt counts towards the CGPA.")
    </p>
</div></div>
