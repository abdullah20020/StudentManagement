@model Student
@{
    ViewData["Title"] = T("Edit student");
}

<div class="page-head">
    <div>
        <h2>@T("Edit student")</h2>
        <div class="sub"><code>@Model.AdmissionNumber</code></div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AdmissionNumber" />
    <input type="hidden" asp-for="EnrollmentDate" />
    <input type="hidden" asp-for="PhotoPath" />

    <partial name="_StudentForm" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> @T("Save changes")</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@T("Cancel")</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
